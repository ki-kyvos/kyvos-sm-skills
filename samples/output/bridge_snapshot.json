  "measures": [
    {
      "name": "m_Net_Sales",
      "expression": "IIF(\n        (\"TRUE\" = (([Measures].[Net Sales]) = 0)),\n        NULL,\n        ([Measures].[Net Sales])\n    )",
      "format_string": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
      "description": "",
      "is_calculated": true,
      "source_dataset": "gel_tracker",
      "aggregation_type": "sum",
      "source_column": null,
      "is_hidden": false
    },
    {
      "name": "m_Prorated_Budget",
      "expression": "",
      "format_string": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
      "description": "",
      "is_calculated": false,
      "source_dataset": "gel_tracker",
      "aggregation_type": "sum",
      "source_column": "prorated_budget",
      "is_hidden": false
    },
    {
      "name": "m_Variance_to_Goal",
      "expression": "([Measures].[m_Net_Sales] - [Measures].[m_Prorated_Budget])",
      "format_string": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
      "description": "",
      "is_calculated": true,
      "source_dataset": "gel_tracker",
      "aggregation_type": "sum",
      "source_column": null,
      "is_hidden": false
    },
    {
      "name": "m_Pct_to_Goal",
      "expression": "IIF(\n    [Measures].[m_Prorated_Budget] = 0,\n    NULL,\n    (IIF(\n        (\"TRUE\" = IsEmpty([Measures].[m_Net_Sales])),\n        0,\n        [Measures].[m_Net_Sales]\n    ) - [Measures].[m_Prorated_Budget]) / [Measures].[m_Prorated_Budget]\n)",
      "format_string": "0.00%;-0.00%;0.00%",
      "description": "",
      "is_calculated": true,
      "source_dataset": "gel_tracker",
      "aggregation_type": "sum",
      "source_column": null,
      "is_hidden": false
    },
    {
      "name": "m_Traffic_Count",
      "expression": "",
      "format_string": "#,0",
      "description": "",
      "is_calculated": false,
      "source_dataset": "gel_tracker",
      "aggregation_type": "sum",
      "source_column": "traffic_count",
      "is_hidden": false
    },
    {
      "name": "m_Transaction_Count",
      "expression": "",
      "format_string": "#,0",
      "description": "",
      "is_calculated": false,
      "source_dataset": "gel_tracker",
      "aggregation_type": "sum",
      "source_column": "transaction_count",
      "is_hidden": false
    },
    {
      "name": "m_Traffic_Conversion",
      "expression": "IIF(\n        (\"TRUE\" = ((IIF(\n        [Measures].[m_Traffic_Count] = 0,\n        NULL,\n        [Measures].[m_Transaction_Count] / [Measures].[m_Traffic_Count]\n    )) = 0)),\n        NULL,\n        (IIF(\n        [Measures].[m_Traffic_Count] = 0,\n        NULL,\n        [Measures].[m_Transaction_Count] / [Measures].[m_Traffic_Count]\n    ))\n    )",
      "format_string": "#,0.00%;-#,0.00%;#,0.00%",
